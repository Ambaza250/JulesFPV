# Add server-only credentials here. Never expose these through Vite's VITE_ prefix.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for managed hosting: the service account JSON as a single-line secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required when adding an authenticated server/API. Generate a unique secret locally.
SESSION_SECRET=
# Set the email address allowed to administer the store.
ADMIN_EMAIL=
# Public origin, with no trailing slash (for example https://julesfpv.example).
APP_ORIGIN=
# Merchant mobile money destination and customer instructions.
PAYMENT_INSTRUCTIONS=
# Set to 1 when running behind a single trusted HTTPS reverse proxy.
TRUST_PROXY=
